{
  "name": "share-log",
  "version": "1.0.0",
  "description": "LAN-P2P Local-First Project Tracker",
  "main": "dist/ui/server.js",
  "bin": "dist/bundle.cjs",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "bytecode": false,
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ],
    "outputPath": "bin"
  },
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "build": "tsc",
    "build:exe": "npm run build && npx -y esbuild src/ui/server.ts --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs && npx -y pkg .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "AUTO_OPEN=false tsx src/ui/server.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1",
    "vitest": "^1.3.1"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
